# =============================================================================
# .env.example — ENVIRONMENT VARIABLE TEMPLATE
# =============================================================================
# Copy this file to .env and fill in your values.
# Variables marked [REQUIRED] will crash the server if missing.
# Variables marked [RECOMMENDED] will log warnings if missing.
# =============================================================================

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8000                                          # [REQUIRED]
CORS_ORIGIN=http://localhost:5173                   # [REQUIRED] React dev server URL
NODE_ENV=development                               # development | production | test

# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/   # [REQUIRED]

# ─── Authentication ──────────────────────────────────────────────────────────
ACCESS_TOKEN_SECRET=your_access_token_secret_here   # [RECOMMENDED] openssl rand -hex 64
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here # [RECOMMENDED] openssl rand -hex 64
JWT_SECRET=your_jwt_secret_legacy_fallback          # Legacy fallback for ACCESS_TOKEN_SECRET
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com  # [RECOMMENDED]

# ─── Python ML Microservice ──────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:5000                # [RECOMMENDED] Python ML API base URL
PYTHON_ML_API_URL=                                  # Legacy alias for ML_SERVICE_URL

# ─── Email (Nodemailer) ──────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com                           # [RECOMMENDED]
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com                     # [RECOMMENDED]
EMAIL_PASS=your_app_password                        # [RECOMMENDED]
EMAIL_FROM=noreply@insurance-stp.com
